<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GamersHub" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/gh_bg_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <!-- real glass: blur whatever is behind the window -->
        <item name="android:windowBlurBehindEnabled">true</item>
        <item name="android:windowBlurBehindRadius">20dp</item>
    </style>
</resources>
