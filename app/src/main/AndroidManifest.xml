<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />

    <!-- Shizuku permission is handled at runtime through the Shizuku API -->

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GamersHub"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Game Space — the landscape in-game hub -->
        <activity
            android:name=".GameSpaceActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:launchMode="singleTask"
            android:theme="@style/Theme.GamersHub" />

        <!-- Floating pop-up panel -->
        <service
            android:name=".overlay.FloatingPanelService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="game_overlay_quick_panel" />
        </service>

        <!-- Crosshair overlay (real, mirrors the original CrosshairFeature) -->
        <service
            android:name=".overlay.CrosshairOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="game_crosshair_overlay" />
        </service>

        <!-- Floating information monitor (real FPS/CPU/GPU/RAM/PING) -->
        <service
            android:name=".overlay.MonitorOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="game_information_monitor" />
        </service>

        <!-- Mapping overlay (macro keys injected with shell identity) -->
        <service
            android:name=".overlay.MappingOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="game_key_mapping" />
        </service>

        <!-- Virtual mouse pointer -->
        <service
            android:name=".overlay.MouseCursorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="game_mouse_cursor" />
        </service>

        <!-- Screen recorder (MediaProjection -> MediaRecorder -> MP4) -->
        <service
            android:name=".core.capture.RecorderService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Real upscale mirror: MediaProjection -> GLES sharpen -> full-screen overlay -->
        <service
            android:name=".core.upscale.UpscaleMirrorService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- RTMP live stream (MediaProjection -> MediaCodec -> RTMP) -->
        <service
            android:name=".core.capture.StreamService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Shizuku user service: must be exported so the Shizuku server can bind it. -->
        <service
            android:name=".core.shizuku.GamersHubShellService"
            android:exported="true"
            android:process=":shellsvc" />

        <!-- Invisible consent proxy: starts screen capture for the overlay panel
             without leaving the running game. -->
        <activity
            android:name=".core.capture.ProjectionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=".projection"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- This provider is required by Shizuku. Do not remove. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>

</manifest>
